   "significa": "contagem do array (`#count`)",
   "origem": "exclusivo do `.8H`"
  },
  {
   "glifo": "`?`",
   "significa": "máscara: campo pode faltar ou ser null",
   "origem": "exclusivo do `.8H`"
  },
  {
   "glifo": "`n`/`b`",
   "significa": "tag de tipo escalar após o size",
